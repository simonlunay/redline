{
  "name": "@simonlunay/redline-generate",
  "version": "0.1.0",
  "description": "Text-to-design generation for Redline: an art director plans the design, images are generated in layers, the best of N candidates is picked by the checker and repaired by the fix loop.",
  "license": "MIT",
  "author": "Simon Lunay",
  "private": true,
  "keywords": [
    "design",
    "ai",
    "generation",
    "claude",
    "flux",
    "redline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonlunay/redline.git",
    "directory": "packages/generate"
  },
  "type": "module",
  "exports": {
    ".": {
      "@simonlunay/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "@simonlunay/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx --conditions=@simonlunay/source eval/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@napi-rs/canvas": "^1.0.10",
    "@simonlunay/redline": "^0.1.0",
    "@simonlunay/redline-agent": "^0.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  }
}
