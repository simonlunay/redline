{
  "name": "@simonlunay/redline-agent",
  "version": "0.1.0",
  "description": "AI fix loop for Redline: check a design, let an LLM repair it, re-check, repeat.",
  "license": "MIT",
  "author": "Simon Lunay",
  "keywords": [
    "design",
    "ai",
    "llm",
    "claude",
    "agent",
    "lint",
    "redline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonlunay/redline.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/simonlunay/redline/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/simonlunay/redline/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "@simonlunay/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "@simonlunay/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx --conditions=@simonlunay/source eval/run.ts",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@simonlunay/redline": "^0.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  }
}
