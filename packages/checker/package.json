{
  "name": "@simonlunay/redline",
  "version": "0.1.0",
  "description": "ESLint for designs: score posters, social posts and ads against real design rules and get machine-readable fixes.",
  "license": "MIT",
  "author": "Simon Lunay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonlunay/redline.git",
    "directory": "packages/checker"
  },
  "homepage": "https://github.com/simonlunay/redline#readme",
  "bugs": {
    "url": "https://github.com/simonlunay/redline/issues"
  },
  "type": "module",
  "keywords": [
    "design",
    "lint",
    "accessibility",
    "contrast",
    "wcag",
    "layout",
    "ai"
  ],
  "exports": {
    ".": {
      "@simonlunay/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./node": {
      "@simonlunay/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "redline": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixture-images": "tsx scripts/make-fixture-images.ts",
    "prepack": "npm run build && node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@simonlunay/redline-agent": "^0.1.0",
    "onnxruntime-node": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "@simonlunay/redline-agent": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    }
  }
}
