{
  "name": "@simonlunay/redline-web",
  "version": "0.1.0",
  "private": true,
  "description": "Redline's web app: replayed runs, an in-browser checker and editor. A static site.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gallery": "tsx --conditions=@simonlunay/source scripts/build-gallery.ts",
    "record-fix-runs": "tsx --conditions=@simonlunay/source scripts/record-fix-runs.ts",
    "predev": "node scripts/copy-fonts.mjs",
    "prebuild": "node scripts/copy-fonts.mjs",
    "postbuild": "node scripts/flatten-segments.mjs && node scripts/check-no-secrets.mjs",
    "e2e": "playwright test",
    "demo-video": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@simonlunay/redline": "^0.1.0",
    "@simonlunay/redline-agent": "^0.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@simonlunay/redline-generate": "^0.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
